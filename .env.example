# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key (https://console.groq.com/keys). Not needed when DEMO_MODE=true.
GROQ_API_KEY=your-groq-api-key-here

# true  = no LLM calls, pre-written outputs for 3 sample accounts (works offline)
# false = live Groq calls
DEMO_MODE=true
